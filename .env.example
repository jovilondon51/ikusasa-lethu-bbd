DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=your-aiven-port
DB_NAME=your-existing-database
DB_USER=your-aiven-user
DB_PASS=replace-locally-do-not-commit
# Optional override for a different CA file mounted into the container.
DB_SSL_CA=
SESSION_SECURE=1
UPLOAD_ROOT=/var/data/ikusasa
# Used only by compose.local.yml. Set your own strong values.
LOCAL_DB_PASSWORD=
LOCAL_DB_ROOT_PASSWORD=
